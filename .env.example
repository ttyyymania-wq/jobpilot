# JobPilot 환경변수 — 실제 값은 .env 에만, 절대 커밋 금지 (harness 0.7)

# LLM (BYOK)
ANTHROPIC_API_KEY=

# 스윙 SWING Playground (행사 공용키, 종료 시 중단)
SWING_API_KEY=
SWING_BASE_URL=https://stage.playground.endpoint.swingmobility.dev

# 로켓펀치 (샌드박스)
ROCKETPUNCH_API_KEY=
ROCKETPUNCH_BASE_URL=

# ODsay 대중교통
ODSAY_API_KEY=

# 날씨 — 기상청(공공데이터포털) 주력 / OpenWeatherMap fallback
KMA_SERVICE_KEY=
OPENWEATHER_API_KEY=

# Google Calendar (OAuth2 Testing 모드)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
